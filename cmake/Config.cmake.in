# Config.cmake.in - Package configuration template
@PACKAGE_INIT@

message(STATUS "Found @PROJECT_NAME@: ${CMAKE_CURRENT_LIST_FILE} (found version \"@PROJECT_VERSION@\")")

# Ensure module scanning is enabled if not already set by the consumer
if (NOT DEFINED CMAKE_CXX_SCAN_FOR_MODULES)
  set(CMAKE_CXX_SCAN_FOR_MODULES @CMAKE_CXX_SCAN_FOR_MODULES@)
endif()

block()
  include(CMakeFindDependencyMacro)

  # Make sure Threads dependency is found before importing our target
  set(THREADS_PREFER_PTHREAD_FLAG ON)  # Prefer pthread when available
  find_dependency(Threads)
endblock()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

check_required_components("@PROJECT_NAME@")